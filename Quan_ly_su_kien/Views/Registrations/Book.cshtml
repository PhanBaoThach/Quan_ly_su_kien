@model Quan_ly_su_kien.ViewModels.BookingViewModel
@{
    ViewData["Title"] = "Đăng Ký Tham Gia Sự Kiện";
    var defaultImg = !string.IsNullOrWhiteSpace(Model.EventImageUrl) 
        ? Model.EventImageUrl 
        : "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&fit=crop";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Events" class="text-decoration-none text-muted">Sự Kiện</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="EventDetail" asp-route-id="@Model.EventId" class="text-decoration-none text-muted">@Model.EventTitle</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Đăng Ký Vé</li>
        </ol>
    </nav>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4">
            <div class="fw-bold mb-1"><i class="fas fa-exclamation-triangle me-1"></i> Có lỗi xảy ra trong quá trình đặt vé:</div>
            <div asp-validation-summary="ModelOnly" class="small text-danger mb-0"></div>
        </div>
    }

    <form asp-action="Book" method="post" id="bookingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="EventId" />

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="fas fa-ticket-alt text-primary me-2"></i>Bước 1: Chọn Hạng Vé Phù Hợp
                        </h5>

                        <div class="d-flex flex-column gap-3 mb-3">
                            @foreach (var ticket in Model.AvailableTickets)
                            {
                                var isChecked = ticket.Id == Model.TicketTypeId;
                                <label class="card border p-3 cursor-pointer ticket-select-card @(isChecked ? "border-primary bg-primary bg-opacity-10 shadow-sm" : "bg-light")" 
                                       for="ticket_@ticket.Id" style="cursor: pointer; transition: all 0.2s ease;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="form-check d-flex align-items-center">
                                            @if (isChecked)
                                            {
                                                <input class="form-check-input me-2 ticket-radio" type="radio" name="TicketTypeId" value="@ticket.Id" id="ticket_@ticket.Id" 
                                                       data-price="@ticket.Price" data-name="@ticket.TypeName" data-available="@ticket.QuantityAvailable" checked />
                                            }
                                            else
                                            {
                                                <input class="form-check-input me-2 ticket-radio" type="radio" name="TicketTypeId" value="@ticket.Id" id="ticket_@ticket.Id" 
                                                       data-price="@ticket.Price" data-name="@ticket.TypeName" data-available="@ticket.QuantityAvailable" />
                                            }
                                            <strong class="text-dark fs-6">@ticket.TypeName</strong>
                                        </div>
                                        <div class="fw-bold fs-5 @(ticket.Price > 0 ? "text-primary" : "text-success")">
                                            @(ticket.Price > 0 ? ticket.Price.ToString("N0") + " ₫" : "Miễn Phí")
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center small text-muted ms-4">
                                        <span>@(string.IsNullOrWhiteSpace(ticket.Description) ? "Vé tiêu chuẩn tham gia toàn bộ chương trình" : ticket.Description)</span>
                                        <span class="badge bg-light text-dark border">Còn @ticket.QuantityAvailable vé</span>
                                    </div>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="TicketTypeId" class="text-danger small"></span>

                        <hr class="my-4">

                        <h5 class="fw-bold text-dark mb-3">
                            <i class="fas fa-calculator text-primary me-2"></i>Bước 2: Chọn Số Lượng Vé
                        </h5>

                        <div class="row align-items-center g-3 mb-2">
                            <div class="col-md-5">
                                <label asp-for="Quantity" class="form-label fw-semibold text-secondary small">Số lượng vé muốn đăng ký:</label>
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary" type="button" id="btnMinus"><i class="fas fa-minus"></i></button>
                                    <input asp-for="Quantity" type="number" min="1" max="10" class="form-control text-center fw-bold fs-5" id="inputQuantity" />
                                    <button class="btn btn-outline-secondary" type="button" id="btnPlus"><i class="fas fa-plus"></i></button>
                                </div>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                            <div class="col-md-7">
                                <div class="alert alert-info py-2 px-3 mb-0 small rounded-3">
                                    <i class="fas fa-info-circle me-1"></i> Tối đa 10 vé cho mỗi lượt đặt. Vé sẽ được tạo kèm mã QR riêng biệt cho từng lượt.
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h5 class="fw-bold text-dark mb-3">
                            <i class="fas fa-user-check text-primary me-2"></i>Bước 3: Thông Tin Người Nhận Vé
                        </h5>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small">Họ và tên người đăng ký <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="fas fa-user"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email nhận vé điện tử <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="email@domain.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary small">Số điện thoại liên hệ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted"><i class="fas fa-phone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="0987654321" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Notes" class="form-label fw-semibold text-secondary small">Ghi chú hoặc yêu cầu đặc biệt</label>
                            <textarea asp-for="Notes" rows="2" class="form-control" placeholder="Ghi chú về chỗ ngồi, hỗ trợ ăn uống (nếu có)..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 80px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="fas fa-receipt text-primary me-2"></i>Tóm Tắt Đơn Đăng Ký
                        </h5>

                        <div class="d-flex gap-3 mb-3">
                            <img src="@defaultImg" alt="@Model.EventTitle" class="rounded-3 object-fit-cover shadow-sm" style="width: 85px; height: 85px;" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&fit=crop';" />
                            <div>
                                <h6 class="fw-bold text-dark mb-1 lh-sm">@Model.EventTitle</h6>
                                <div class="small text-muted mb-1"><i class="fas fa-map-marker-alt text-danger me-1"></i>@Model.EventLocation</div>
                                <div class="small text-muted"><i class="fas fa-calendar-alt text-primary me-1"></i>@Model.EventStartDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>

                        <ul class="list-group list-group-flush small mb-3">
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Đơn vị tổ chức:</span>
                                <span class="fw-semibold text-dark">@Model.OrganizerName</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Hạng vé đã chọn:</span>
                                <span class="fw-bold text-dark" id="summaryTicketName">--</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Đơn giá vé:</span>
                                <span class="fw-bold text-dark" id="summaryUnitPrice">--</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Số lượng vé:</span>
                                <span class="fw-bold text-dark" id="summaryQuantity">1</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2 border-top">
                                <span class="text-muted">Phí dịch vụ & phát hành:</span>
                                <span class="text-success fw-semibold">Miễn phí</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-top">
                                <span class="fs-6 fw-bold text-dark">Tổng thanh toán:</span>
                                <span class="fs-4 fw-bold text-primary" id="summaryTotalPrice">0 ₫</span>
                            </li>
                        </ul>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-2"></i>Xác Nhận Đăng Ký Vé
                            </button>
                            <a asp-controller="Home" asp-action="EventDetail" asp-route-id="@Model.EventId" class="btn btn-outline-secondary rounded-pill fw-semibold">
                                <i class="fas fa-times me-1"></i> Hủy Bỏ
                            </a>
                        </div>

                        <div class="mt-3 text-center small text-muted">
                            <i class="fas fa-shield-alt text-success me-1"></i> Mã vé và QR Code sẽ được hiển thị ngay lập tức sau khi xác nhận.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const radioButtons = document.querySelectorAll('.ticket-radio');
            const inputQuantity = document.getElementById('inputQuantity');
            const btnMinus = document.getElementById('btnMinus');
            const btnPlus = document.getElementById('btnPlus');
            const summaryTicketName = document.getElementById('summaryTicketName');
            const summaryUnitPrice = document.getElementById('summaryUnitPrice');
            const summaryQuantity = document.getElementById('summaryQuantity');
            const summaryTotalPrice = document.getElementById('summaryTotalPrice');
            const ticketCards = document.querySelectorAll('.ticket-select-card');

            function getSelectedTicket() {
                for (const r of radioButtons) {
                    if (r.checked) return r;
                }
                return radioButtons[0];
            }

            function updatePricing() {
                const selected = getSelectedTicket();
                if (!selected) return;

                const price = parseFloat(selected.getAttribute('data-price')) || 0;
                const name = selected.getAttribute('data-name') || '';
                const maxAvailable = parseInt(selected.getAttribute('data-available')) || 10;
                let quantity = parseInt(inputQuantity.value) || 1;

                if (quantity < 1) quantity = 1;
                if (quantity > 10) quantity = 10;
                if (quantity > maxAvailable) quantity = maxAvailable;

                inputQuantity.value = quantity;
                summaryTicketName.textContent = name;
                summaryQuantity.textContent = quantity + ' vé';

                if (price === 0) {
                    summaryUnitPrice.textContent = 'Miễn Phí';
                    summaryTotalPrice.textContent = '0 ₫';
                } else {
                    summaryUnitPrice.textContent = price.toLocaleString('vi-VN') + ' ₫';
                    const total = price * quantity;
                    summaryTotalPrice.textContent = total.toLocaleString('vi-VN') + ' ₫';
                }

                ticketCards.forEach(card => {
                    const radio = card.querySelector('.ticket-radio');
                    if (radio && radio.checked) {
                        card.classList.add('border-primary', 'bg-primary', 'bg-opacity-10', 'shadow-sm');
                        card.classList.remove('bg-light');
                    } else {
                        card.classList.remove('border-primary', 'bg-primary', 'bg-opacity-10', 'shadow-sm');
                        card.classList.add('bg-light');
                    }
                });
            }

            radioButtons.forEach(radio => {
                radio.addEventListener('change', updatePricing);
            });

            ticketCards.forEach(card => {
                card.addEventListener('click', function () {
                    const radio = card.querySelector('.ticket-radio');
                    if (radio) {
                        radio.checked = true;
                        updatePricing();
                    }
                });
            });

            btnMinus.addEventListener('click', function () {
                let current = parseInt(inputQuantity.value) || 1;
                if (current > 1) {
                    inputQuantity.value = current - 1;
                    updatePricing();
                }
            });

            btnPlus.addEventListener('click', function () {
                let current = parseInt(inputQuantity.value) || 1;
                if (current < 10) {
                    inputQuantity.value = current + 1;
                    updatePricing();
                }
            });

            inputQuantity.addEventListener('input', updatePricing);
            updatePricing();
        });
    </script>
}
