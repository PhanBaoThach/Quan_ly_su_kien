@model IEnumerable<Quan_ly_su_kien.Models.Registration>
@{
    ViewData["Title"] = "Vé Tham Gia Sự Kiện Của Tôi";
    var currentStatus = (string)(ViewBag.CurrentStatus ?? "all");
    var currentSearch = (string)(ViewBag.CurrentSearch ?? string.Empty);
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang Chủ</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Vé Của Tôi</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold mb-1 text-dark">
                <i class="fas fa-ticket-alt text-primary me-2"></i>Vé Tham Gia Sự Kiện Của Tôi
            </h2>
            <p class="text-muted small mb-0">Theo dõi thông tin đăng ký, quản lý mã vé điện tử QR Code và lịch sử tham dự.</p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Events" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="fas fa-compass me-2"></i>Khám Phá Thêm Sự Kiện
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm mb-4 alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle fs-4 me-3 text-success"></i>
                <div>
                    <strong>Thành công!</strong> @TempData["SuccessMessage"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4 alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fs-4 me-3 text-danger"></i>
                <div>
                    <strong>Thông báo lỗi:</strong> @TempData["ErrorMessage"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                        <i class="fas fa-ticket-alt fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TỔNG SỐ VÉ</div>
                        <div class="fs-4 fw-bold text-dark">@(ViewBag.TotalTicketsCount ?? 0)</div>
                        <small class="text-muted">Vé đã đăng ký</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                        <i class="fas fa-calendar-check fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">SẮP DIỄN RA</div>
                        <div class="fs-4 fw-bold text-success">@(ViewBag.UpcomingCount ?? 0)</div>
                        <small class="text-muted">Sự kiện chuẩn bị tới</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                        <i class="fas fa-qrcode fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">ĐÃ CHECK-IN</div>
                        <div class="fs-4 fw-bold text-dark">@(ViewBag.CheckedInCount ?? 0)</div>
                        <small class="text-muted">Đã quét vé vào cổng</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                        <i class="fas fa-money-bill-wave fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TỔNG CHI TIÊU</div>
                        <div class="fs-4 fw-bold text-dark">@(((decimal)(ViewBag.TotalSpent ?? 0)).ToString("N0")) <small class="fs-6">₫</small></div>
                        <small class="text-muted">Đã thanh toán</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <ul class="nav nav-pills gap-1">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentStatus == "all" ? "active" : "text-muted")" 
                           asp-action="MyTickets" asp-route-status="all" asp-route-search="@currentSearch">
                            Tất cả vé
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentStatus == "upcoming" ? "active" : "text-muted")" 
                           asp-action="MyTickets" asp-route-status="upcoming" asp-route-search="@currentSearch">
                            Sắp diễn ra
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentStatus == "past" ? "active" : "text-muted")" 
                           asp-action="MyTickets" asp-route-status="past" asp-route-search="@currentSearch">
                            Đã diễn ra
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentStatus == "cancelled" ? "active" : "text-muted")" 
                           asp-action="MyTickets" asp-route-status="cancelled" asp-route-search="@currentSearch">
                            Đã hủy
                        </a>
                    </li>
                </ul>

                <form method="get" asp-action="MyTickets" class="d-flex gap-2">
                    <input type="hidden" name="status" value="@currentStatus" />
                    <div class="input-group">
                        <input type="text" name="search" value="@currentSearch" class="form-control form-control-sm rounded-start-pill ps-3" placeholder="Tìm theo tên sự kiện, mã vé..." style="min-width: 240px;" />
                        <button type="submit" class="btn btn-sm btn-primary rounded-end-pill px-3">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(currentSearch))
                    {
                        <a asp-action="MyTickets" asp-route-status="@currentStatus" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            <i class="fas fa-redo"></i>
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body py-5">
                <div class="avatar-circle mx-auto mb-3 bg-light text-muted rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px;">
                    <i class="fas fa-ticket-alt fs-1 text-muted"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Chưa tìm thấy vé tham dự nào</h4>
                <p class="text-muted small mb-4">Bạn chưa đăng ký vé nào hoặc không có vé nào phù hợp với bộ lọc hiện tại.</p>
                <a asp-controller="Home" asp-action="Events" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="fas fa-compass me-2"></i>Khám Phá Các Sự Kiện Hot
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var eventImg = !string.IsNullOrWhiteSpace(item.Event?.ImageUrl)
                    ? item.Event.ImageUrl
                    : "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&fit=crop";
                bool isPast = item.Event != null && item.Event.EndDate < DateTime.Now;
                bool canCancel = item.Status == "Confirmed" && !item.CheckInStatus && item.Event != null && item.Event.StartDate > DateTime.Now;

                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden hover-shadow transition-all">
                        <div class="card-body p-4">
                            <div class="d-flex gap-3 mb-3">
                                <img src="@eventImg" alt="@(item.Event?.Title ?? "Event")" class="rounded-3 object-fit-cover shadow-sm flex-shrink-0" style="width: 100px; height: 100px;" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&fit=crop';" />
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                        <span class="badge bg-light text-primary border small rounded-pill">
                                            @(item.Event?.Category?.Name ?? "Sự kiện")
                                        </span>
                                        @if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small">
                                                <i class="fas fa-ban me-1"></i>Đã Hủy
                                            </span>
                                        }
                                        else if (item.CheckInStatus)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2 py-1 small">
                                                <i class="fas fa-check-double me-1"></i>Đã Check-in
                                            </span>
                                        }
                                        else if (isPast)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-1 small">
                                                <i class="fas fa-history me-1"></i>Đã Kết Thúc
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                                <i class="fas fa-check-circle me-1"></i>Vé Hợp Lệ
                                            </span>
                                        }
                                    </div>

                                    <h5 class="fw-bold text-dark mb-1 text-truncate" title="@item.Event?.Title">
                                        <a asp-action="TicketDetails" asp-route-id="@item.Id" class="text-dark text-decoration-none hover-primary">
                                            @(item.Event?.Title ?? "Sự kiện")
                                        </a>
                                    </h5>
                                    <div class="small text-muted mb-1 text-truncate">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i>@(item.Event?.Location ?? "Địa điểm đang cập nhật")
                                    </div>
                                    <div class="small text-muted">
                                        <i class="fas fa-calendar-alt text-primary me-1"></i>@(item.Event?.StartDate.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                    </div>
                                </div>
                            </div>

                            <hr class="my-3 opacity-10">

                            <div class="d-flex justify-content-between align-items-center mb-3 small bg-light p-2 px-3 rounded-3">
                                <div>
                                    <span class="text-muted">Hạng vé:</span> <strong>@(item.TicketType?.TypeName ?? "Tiêu chuẩn")</strong> 
                                    <span class="text-muted mx-1">•</span> 
                                    <span class="text-muted">Số lượng:</span> <strong>@item.Quantity</strong>
                                </div>
                                <div class="fw-bold fs-6 @(item.TotalPrice > 0 ? "text-primary" : "text-success")">
                                    @(item.TotalPrice > 0 ? item.TotalPrice.ToString("N0") + " ₫" : "Miễn Phí")
                                </div>
                            </div>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="small">
                                    <span class="text-muted">Mã vé:</span>
                                    <code class="fw-bold text-primary">@item.QrCode</code>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="TicketDetails" asp-route-id="@item.Id" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm">
                                        <i class="fas fa-qrcode me-1"></i> Xem Vé & QR
                                    </a>
                                    @if (canCancel)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đăng ký vé sự kiện này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Hủy vé">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
    }
    .transition-all {
        transition: all 0.25s ease-in-out;
    }
    .hover-primary:hover {
        color: #0d6efd !important;
    }
</style>

