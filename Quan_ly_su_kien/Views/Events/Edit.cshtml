@model Quan_ly_su_kien.ViewModels.EventFormViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Sự Kiện";
    var defaultImage = !string.IsNullOrWhiteSpace(Model.ImageUrl) 
        ? Model.ImageUrl 
        : "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&fit=crop";
}

<div class="container py-4">
    <!-- Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang Chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="MyEvents" class="text-decoration-none text-muted">Quản Lý Sự Kiện</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-muted">Chi Tiết</a></li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Chỉnh Sửa</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h3 fw-bold mb-1 text-dark">
                    <i class="fas fa-edit text-primary me-2"></i>Chỉnh Sửa Sự Kiện
                </h2>
                <p class="text-muted small mb-0">Cập nhật thông tin chi tiết cho sự kiện: <strong class="text-dark">@Model.Title</strong></p>
            </div>
            <div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info rounded-pill px-3 fw-semibold">
                    <i class="fas fa-eye me-1"></i> Xem Trang Chi Tiết
                </a>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4">
            <div class="fw-bold mb-1"><i class="fas fa-exclamation-triangle me-1"></i> Vui lòng kiểm tra lại thông tin:</div>
            <div asp-validation-summary="ModelOnly" class="small text-danger mb-0"></div>
        </div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" id="hiddenImageUrl" />

        <div class="row g-4">
            <!-- Cột trái: Thông tin chính -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="fas fa-info-circle text-primary me-2"></i>Thông Tin Sự Kiện
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold text-dark">
                                Tiêu đề sự kiện <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold text-dark">
                                    Danh mục sự kiện <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select rounded-3">
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-dark">
                                    Trạng thái sự kiện <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Status" class="form-select rounded-3">
                                    <option value="Draft">Bản nháp (Draft)</option>
                                    <option value="Open">Mở đăng ký vé (Open)</option>
                                    <option value="Ongoing">Đang diễn ra (Ongoing)</option>
                                    <option value="Completed">Đã kết thúc (Completed)</option>
                                    <option value="Cancelled">Đã hủy (Cancelled)</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold text-dark">
                                    Thời gian bắt đầu <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control rounded-3" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold text-dark">
                                    Thời gian kết thúc <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control rounded-3" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label asp-for="Location" class="form-label fw-semibold text-dark">
                                    Địa điểm tổ chức <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-map-marker-alt text-danger"></i></span>
                                    <input asp-for="Location" class="form-control border-start-0 rounded-end-3" />
                                </div>
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxTickets" class="form-label fw-semibold text-dark">
                                    Số lượng vé tối đa <span class="text-danger">*</span>
                                </label>
                                <input asp-for="MaxTickets" type="number" min="1" max="1000000" class="form-control rounded-3" />
                                <span asp-validation-for="MaxTickets" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Description" class="form-label fw-semibold text-dark">
                                Mô tả chi tiết sự kiện <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" rows="8" class="form-control rounded-3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Ảnh bìa & Trợ giúp -->
            <div class="col-lg-4">
                <!-- Card Ảnh bìa -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="fas fa-image text-primary me-2"></i>Ảnh Bìa Sự Kiện
                        </h5>

                        <!-- Preview khung ảnh hiện tại -->
                        <div class="mb-3 text-center">
                            <div class="ratio ratio-16x9 bg-light rounded-3 overflow-hidden border">
                                <img id="previewImage" 
                                     src="@defaultImage" 
                                     alt="Xem trước ảnh bìa" 
                                     class="object-fit-cover w-100 h-100" 
                                     onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&fit=crop';" />
                            </div>
                            <div class="small text-muted mt-2">Ảnh bìa hiện tại</div>
                        </div>

                        <!-- Lựa chọn 1: Upload File Mới -->
                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-semibold text-dark">
                                <i class="fas fa-upload text-secondary me-1"></i> Đổi ảnh bằng file mới
                            </label>
                            <input asp-for="ImageFile" type="file" accept="image/*" class="form-control rounded-3" id="fileUploadInput" onchange="previewFile(event)" />
                            <small class="text-muted d-block mt-1">Để trống nếu muốn giữ nguyên ảnh hiện tại</small>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <div class="text-center my-2 text-muted fw-semibold small">--- HOẶC ---</div>

                        <!-- Lựa chọn 2: Đường dẫn URL -->
                        <div class="mb-0">
                            <label class="form-label fw-semibold text-dark">
                                <i class="fas fa-link text-secondary me-1"></i> Thay bằng link URL mới
                            </label>
                            <input type="text" class="form-control rounded-3" value="@Model.ImageUrl" id="urlInput" oninput="previewUrl(this.value)" />
                        </div>
                    </div>
                </div>

                <!-- Nút thao tác -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                        <i class="fas fa-save me-1"></i> Lưu Cập Nhật
                    </button>
                    <a asp-action="MyEvents" class="btn btn-outline-secondary rounded-pill fw-semibold">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại Danh Sách
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewFile(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImage').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewUrl(url) {
            if (url && url.trim().length > 5) {
                document.getElementById('previewImage').src = url.trim();
                document.getElementById('hiddenImageUrl').value = url.trim();
            }
        }
    </script>
}

