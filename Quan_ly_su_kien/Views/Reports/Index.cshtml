@model IEnumerable<Quan_ly_su_kien.Controllers.TicketReportItem>
@{
    ViewData["Title"] = "Thống kê doanh thu & Báo cáo";
    var events = ViewBag.Events as List<Quan_ly_su_kien.Models.Event>;
    int? selectedEventId = ViewBag.SelectedEventId;
}

<div class="container py-4">
    <!-- Tiêu đề & Bộ lọc sự kiện -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Thống Kê Doanh Thu & Báo Cáo</h2>
            <p class="text-muted mb-0">Tổng hợp tình hình bán vé và doanh thu thực tế của các sự kiện</p>
        </div>

        <form method="get" asp-action="Index" class="d-flex gap-2">
            <select name="eventId" class="form-select" style="min-width: 250px;">
                <option value="">-- Tất cả sự kiện --</option>
                @if (events != null)
                {
                    foreach (var ev in events)
                    {
                        <option value="@ev.Id" selected="@(selectedEventId == ev.Id)">@ev.Title</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-primary text-nowrap">Lọc dữ liệu</button>
        </form>
    </div>

    <!-- 3 Thẻ chỉ số tổng quan (KPI Cards) -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-success shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75">Tổng Doanh Thu</h6>
                    <h3 class="fw-bold mb-0">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) VNĐ</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75">Vé Đã Bán / Phát Hành</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalTicketsSold / @ViewBag.TotalTicketsIssued vé</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-dark bg-warning shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75">Số Sự Kiện Thống Kê</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalEvents sự kiện</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ & Bảng chi tiết -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold py-3">
                    Biểu Đồ Doanh Thu Theo Hạng Vé
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold py-3">
                    Chi Tiết Doanh Thu Từng Hạng Vé
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sự Kiện - Hạng Vé</th>
                                    <th class="text-end">Giá Vé</th>
                                    <th class="text-center">Đã Bán</th>
                                    <th class="text-end">Doanh Thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">Chưa có dữ liệu vé nào.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@item.TicketName</div>
                                                <small class="text-muted">@item.EventTitle</small>
                                            </td>
                                            <td class="text-end">@item.Price.ToString("N0")đ</td>
                                            <td class="text-center">@item.SoldCount / @item.TotalQuantity</td>
                                            <td class="text-end fw-bold text-success">@item.Revenue.ToString("N0")đ</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels));
        const revenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartRevenues));

        const ctx = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenues,
                    backgroundColor: [
                        'rgba(25, 135, 84, 0.75)',
                        'rgba(13, 110, 253, 0.75)',
                        'rgba(255, 193, 7, 0.75)',
                        'rgba(220, 53, 69, 0.75)',
                        'rgba(111, 66, 193, 0.75)'
                    ],
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                }
            }
        });
    </script>
}