@model Event
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Events">Sự Kiện</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Cột Nội Dung Sự Kiện -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm overflow-hidden mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1000&auto=format&fit=crop&q=80" : Model.ImageUrl)" 
                     class="w-100 object-fit-cover" 
                     style="max-height: 400px;" 
                     alt="@Model.Title" />

                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-primary px-3 py-2 rounded-pill">
                            <i class="fas fa-tag me-1"></i>@(Model.Category?.Name ?? "Chung")
                        </span>
                        @if (Model.Status == "Open")
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                <i class="fas fa-check-circle me-1"></i>Đang mở đăng ký vé
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@Model.Status</span>
                        }
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            <i class="fas fa-ticket-alt me-1"></i>Tối đa @Model.MaxTickets vé
                        </span>
                    </div>

                    <h2 class="fw-bold text-dark mb-4">@Model.Title</h2>

                    <!-- Thông tin cơ bản -->
                    <div class="row g-3 p-3 bg-light rounded-3 mb-4">
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3">
                                <i class="fas fa-calendar-alt fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted fw-semibold d-block">THỜI GIAN</small>
                                <strong>@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</strong>
                                <small class="text-muted d-block">đến @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="bg-danger-subtle text-danger rounded-circle p-3 me-3">
                                <i class="fas fa-map-marker-alt fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted fw-semibold d-block">ĐỊA ĐIỂM TỔ CHỨC</small>
                                <strong>@Model.Location</strong>
                            </div>
                        </div>
                    </div>

                    <h4 class="fw-bold text-dark mb-3">Mô Tả Chi Tiết Sự Kiện</h4>
                    <div class="text-secondary lh-lg mb-4" style="white-space: pre-line;">
                        @Model.Description
                    </div>

                    <!-- Khách mời & Diễn giả (US-08) -->
                    @if (Model.Guests.Any())
                    {
                        <h4 class="fw-bold text-dark mb-3"><i class="fas fa-microphone-alt me-2 text-primary"></i>Diễn Giả & Khách Mời</h4>
                        <div class="row g-3 mb-4">
                            @foreach (var g in Model.Guests)
                            {
                                <div class="col-md-6">
                                    <div class="card p-3 border-0 bg-light d-flex flex-row align-items-center">
                                        <div class="avatar-circle me-3 bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                                            @g.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@g.FullName</div>
                                            <small class="text-muted">@(string.IsNullOrEmpty(g.RoleTitle) ? "Khách mời đặc biệt" : g.RoleTitle)</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột Đặt Vé & Thông Tin Ban Tổ Chức -->
        <div class="col-lg-4">
            <!-- Thẻ Danh Sách Loại Vé -->
            <div class="card border-0 shadow-sm p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-ticket-alt text-primary me-2"></i>Các Loại Vé Phát Hành</h5>
                
                @if (!Model.TicketTypes.Any())
                {
                    <div class="text-muted small">Hiện chưa có loại vé nào được công bố cho sự kiện này.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3 mb-3">
                        @foreach (var ticket in Model.TicketTypes)
                        {
                            var remaining = ticket.Quantity - ticket.SoldQuantity;
                            <div class="card border p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="fw-bold text-dark">@ticket.TypeName</div>
                                    @if (ticket.Price == 0)
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1">Miễn Phí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary rounded-pill px-2 py-1">@ticket.Price.ToString("N0") đ</span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>Còn lại: <strong>@remaining / @ticket.Quantity</strong> vé</span>
                                    <span>Đã bán: @ticket.SoldQuantity</span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <button type="button" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm" onclick="alert('Đã ghi nhận yêu cầu đặt vé thành công! Mã vé điện tử sẽ được cập nhật trong mục Vé Của Tôi.');">
                            <i class="fas fa-shopping-cart me-2"></i>Đăng Ký Đặt Vé Ngay
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-warning text-dark w-100 py-2 rounded-pill fw-semibold shadow-sm">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng Nhập Để Đặt Vé
                        </a>
                    }
                }
            </div>

            <!-- Thẻ Ban Tổ Chức -->
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-bullhorn text-warning me-2"></i>Đơn Vị Tổ Chức</h5>
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar-circle me-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 48px; height: 48px;">
                        @((Model.Organizer?.FullName ?? "B").Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@(Model.Organizer?.FullName ?? "Ban Tổ Chức")</div>
                        <small class="text-muted">@(Model.Organizer?.Email ?? "contact@eventmana.vn")</small>
                    </div>
                </div>
                <div class="text-muted small">
                    <i class="fas fa-shield-alt text-success me-1"></i> Ban tổ chức đã được xác thực danh tính trên nền tảng EventMana.
                </div>
            </div>
        </div>
    </div>
</div>

