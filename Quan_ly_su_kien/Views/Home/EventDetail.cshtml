@model Event
@{
    ViewData["Title"] = Model.Title;
    bool isOpen = Model.Status == "Open" && Model.EndDate > DateTime.Now;
    var availableTickets = Model.TicketTypes.Where(t => t.IsActive && (t.QuantityAvailable > 0 || (t.QuantityTotal - t.SoldQuantity) > 0)).ToList();
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Events">Sự Kiện</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4 alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm overflow-hidden mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1000&auto=format&fit=crop&q=80" : Model.ImageUrl)" 
                     class="w-100 object-fit-cover" 
                     style="max-height: 400px;" 
                     alt="@Model.Title" />

                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-primary px-3 py-2 rounded-pill">
                            <i class="fas fa-tag me-1"></i>@(Model.Category?.Name ?? "Chung")
                        </span>
                        @if (isOpen)
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                <i class="fas fa-check-circle me-1"></i>Đang mở đăng ký vé
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@Model.Status</span>
                        }
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            <i class="fas fa-ticket-alt me-1"></i>Tối đa @Model.MaxTickets vé
                        </span>
                    </div>

                    <h2 class="fw-bold text-dark mb-4">@Model.Title</h2>

                    <div class="row g-3 p-3 bg-light rounded-3 mb-4">
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3">
                                <i class="fas fa-calendar-alt fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted fw-semibold d-block">THỜI GIAN</small>
                                <strong>@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</strong>
                                <small class="text-muted d-block">đến @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="bg-danger-subtle text-danger rounded-circle p-3 me-3">
                                <i class="fas fa-map-marker-alt fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted fw-semibold d-block">ĐỊA ĐIỂM TỔ CHỨC</small>
                                <strong>@Model.Location</strong>
                            </div>
                        </div>
                    </div>

                    <h4 class="fw-bold text-dark mb-3">Mô Tả Chi Tiết Sự Kiện</h4>
                    <div class="text-secondary lh-lg mb-4" style="white-space: pre-line;">
                        @Model.Description
                    </div>

                    @if (Model.Guests.Any())
                    {
                        <h4 class="fw-bold text-dark mb-3"><i class="fas fa-microphone-alt me-2 text-primary"></i>Diễn Giả & Khách Mời</h4>
                        <div class="row g-3 mb-4">
                            @foreach (var g in Model.Guests)
                            {
                                <div class="col-md-6">
                                    <div class="card p-3 border-0 bg-light d-flex flex-row align-items-center">
                                        <div class="avatar-circle me-3 bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                                            @g.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@g.FullName</div>
                                            <small class="text-muted">@(string.IsNullOrEmpty(g.RoleTitle) ? "Khách mời đặc biệt" : g.RoleTitle)</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-ticket-alt text-primary me-2"></i>Các Loại Vé Phát Hành</h5>
                
                @if (!Model.TicketTypes.Any())
                {
                    <div class="text-muted small">Hiện chưa có loại vé nào được công bố cho sự kiện này.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3 mb-3">
                        @foreach (var ticket in Model.TicketTypes)
                        {
                            var remaining = ticket.QuantityAvailable > 0 ? ticket.QuantityAvailable : Math.Max(0, ticket.QuantityTotal - ticket.SoldQuantity);
                            var soldCount = ticket.QuantityTotal > remaining ? (ticket.QuantityTotal - remaining) : ticket.SoldQuantity;
                            <div class="card border p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="fw-bold text-dark">@ticket.TypeName</div>
                                    @if (ticket.Price == 0)
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1">Miễn Phí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary rounded-pill px-2 py-1">@ticket.Price.ToString("N0") ₫</span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
                                    <span>Còn lại: <strong>@remaining / @ticket.QuantityTotal</strong> vé</span>
                                    <span>Đã bán: @soldCount</span>
                                </div>
                                @if (isOpen && remaining > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-semibold" onclick="openBookingModal(@ticket.Id, @ticket.Price, '@ticket.TypeName', @remaining)">
                                        <i class="fas fa-ticket-alt me-1"></i> Chọn Loại Vé Này
                                    </button>
                                }
                                else if (remaining <= 0)
                                {
                                    <span class="badge bg-secondary rounded-pill py-2 w-100">Đã Hết Vé</span>
                                }
                            </div>
                        }
                    </div>

                    @if (isOpen && availableTickets.Any())
                    {
                        var firstTicket = availableTickets.First();
                        <button type="button" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm" onclick="openBookingModal(@firstTicket.Id, @firstTicket.Price, '@firstTicket.TypeName', @firstTicket.QuantityAvailable)">
                            <i class="fas fa-shopping-cart me-2"></i>Đăng Ký Đặt Vé Ngay
                        </button>
                    }
                    else if (!isOpen)
                    {
                        <div class="alert alert-secondary text-center py-2 mb-0 small rounded-pill">
                            <i class="fas fa-lock me-1"></i> Sự kiện hiện không mở đăng ký vé
                        </div>
                    }
                }
            </div>

            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-bullhorn text-warning me-2"></i>Đơn Vị Tổ Chức</h5>
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar-circle me-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 48px; height: 48px;">
                        @((Model.Organizer?.FullName ?? "B").Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@(Model.Organizer?.FullName ?? "Ban Tổ Chức")</div>
                        <small class="text-muted">@(Model.Organizer?.Email ?? "contact@eventmana.vn")</small>
                    </div>
                </div>
                <div class="text-muted small">
                    <i class="fas fa-shield-alt text-success me-1"></i> Ban tổ chức đã được xác thực danh tính trên nền tảng EventMana.
                </div>
            </div>
        </div>
    </div>
</div>

@if (isOpen && availableTickets.Any())
{
    <div class="modal fade" id="modalBooking" tabindex="-1" aria-labelledby="modalBookingLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <div>
                        <h4 class="modal-title fw-bold text-dark" id="modalBookingLabel">
                            <i class="fas fa-ticket-alt text-primary me-2"></i>Đăng Ký Vé Tham Gia Sự Kiện
                        </h4>
                        <p class="text-muted small mb-0">Điền thông tin người tham gia để hệ thống tạo vé điện tử và mã QR Code.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form asp-controller="Registrations" asp-action="Book" method="post" id="formQuickBook">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EventId" value="@Model.Id" />

                    <div class="modal-body p-4">
                        <div class="p-3 bg-light rounded-4 mb-4">
                            <div class="small text-muted mb-1 text-uppercase fw-semibold">Sự kiện đăng ký:</div>
                            <h5 class="fw-bold text-dark mb-1">@Model.Title</h5>
                            <div class="small text-muted">
                                <i class="fas fa-calendar-alt text-primary me-1"></i> @Model.StartDate.ToString("dd/MM/yyyy HH:mm")
                                <span class="mx-2">•</span>
                                <i class="fas fa-map-marker-alt text-danger me-1"></i> @Model.Location
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-7">
                                <label class="form-label fw-semibold text-secondary small">Chọn hạng vé tham gia <span class="text-danger">*</span></label>
                                <select name="TicketTypeId" id="selectTicketType" class="form-select rounded-3 py-2" onchange="onTicketChange()">
                                    @foreach (var t in availableTickets)
                                    {
                                        var rem = t.QuantityAvailable > 0 ? t.QuantityAvailable : Math.Max(0, t.QuantityTotal - t.SoldQuantity);
                                        <option value="@t.Id" data-price="@t.Price" data-available="@rem" data-name="@t.TypeName">
                                            @t.TypeName - @(t.Price == 0 ? "Miễn Phí" : t.Price.ToString("N0") + " ₫") (Còn @rem vé)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold text-secondary small">Số lượng vé đặt <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary" type="button" onclick="adjustQty(-1)"><i class="fas fa-minus"></i></button>
                                    <input type="number" name="Quantity" id="inputModalQty" class="form-control text-center fw-bold fs-5" value="1" min="1" max="10" oninput="calculateModalTotal()" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="adjustQty(1)"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>
                        </div>

                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-user-edit text-primary me-2"></i>Thông Tin Người Tham Gia Nhận Vé</h6>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Họ và tên người nhận vé <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="fas fa-user"></i></span>
                                <input type="text" name="FullName" id="inputFullName" class="form-control" required placeholder="Ví dụ: Nguyễn Văn A" value="@(User.Identity?.Name ?? "")" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Email nhận vé điện tử <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted"><i class="fas fa-envelope"></i></span>
                                    <input type="email" name="Email" id="inputEmail" class="form-control" required placeholder="email@example.com" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Số điện thoại liên hệ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted"><i class="fas fa-phone"></i></span>
                                    <input type="tel" name="PhoneNumber" id="inputPhone" class="form-control" placeholder="0987654321" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Ghi chú (nếu có)</label>
                            <textarea name="Notes" rows="2" class="form-control" placeholder="Yêu cầu chỗ ngồi hoặc lưu ý thêm cho ban tổ chức..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-4 border">
                            <div>
                                <div class="small text-muted">Đơn giá: <strong id="lblUnitPrice" class="text-dark">0 ₫</strong></div>
                                <div class="small text-muted">Số lượng: <strong id="lblQuantity" class="text-dark">1 vé</strong></div>
                            </div>
                            <div class="text-end">
                                <span class="small text-muted d-block">Tổng tiền thanh toán:</span>
                                <span id="lblTotalPrice" class="fs-4 fw-bold text-primary">0 ₫</span>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 p-4 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                            <i class="fas fa-check-circle me-1"></i> Xác Nhận Đăng Ký Vé
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            let bookingModalInstance = null;

            function openBookingModal(ticketId, price, name, available) {
                const select = document.getElementById('selectTicketType');
                if (select) {
                    select.value = ticketId;
                }
                const modalEl = document.getElementById('modalBooking');
                if (modalEl) {
                    if (!bookingModalInstance) {
                        bookingModalInstance = new bootstrap.Modal(modalEl);
                    }
                    calculateModalTotal();
                    bookingModalInstance.show();
                }
            }

            function onTicketChange() {
                calculateModalTotal();
            }

            function adjustQty(delta) {
                const qtyInput = document.getElementById('inputModalQty');
                if (!qtyInput) return;
                let val = parseInt(qtyInput.value) || 1;
                val += delta;
                if (val < 1) val = 1;
                if (val > 10) val = 10;
                qtyInput.value = val;
                calculateModalTotal();
            }

            function calculateModalTotal() {
                const select = document.getElementById('selectTicketType');
                const qtyInput = document.getElementById('inputModalQty');
                const lblUnitPrice = document.getElementById('lblUnitPrice');
                const lblQuantity = document.getElementById('lblQuantity');
                const lblTotalPrice = document.getElementById('lblTotalPrice');

                if (!select || !qtyInput) return;

                const selectedOption = select.options[select.selectedIndex];
                if (!selectedOption) return;

                const price = parseFloat(selectedOption.getAttribute('data-price')) || 0;
                const available = parseInt(selectedOption.getAttribute('data-available')) || 10;
                let qty = parseInt(qtyInput.value) || 1;

                if (qty < 1) qty = 1;
                if (qty > 10) qty = 10;
                if (qty > available) qty = available;
                qtyInput.value = qty;

                if (lblQuantity) lblQuantity.textContent = qty + ' vé';

                if (price === 0) {
                    if (lblUnitPrice) lblUnitPrice.textContent = 'Miễn Phí';
                    if (lblTotalPrice) lblTotalPrice.textContent = 'Miễn Phí';
                } else {
                    if (lblUnitPrice) lblUnitPrice.textContent = price.toLocaleString('vi-VN') + ' ₫';
                    const total = price * qty;
                    if (lblTotalPrice) lblTotalPrice.textContent = total.toLocaleString('vi-VN') + ' ₫';
                }
            }
        </script>
    }
}
