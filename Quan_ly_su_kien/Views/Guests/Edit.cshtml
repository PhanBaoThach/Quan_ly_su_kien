@model Quan_ly_su_kien.Models.Guest
@{
    ViewData["Title"] = "Cập Nhật Khách Mời";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="p-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #f59e0b 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="fas fa-user-pen fa-lg"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Cập Nhật Thông Tin Khách Mời</h4>
                            <small class="text-white-50">Chỉnh sửa thông tin định danh và trạng thái tham dự</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Sự kiện tổ chức</label>
                            <select asp-for="EventId" class="form-select form-select-lg rounded-3" asp-items="ViewBag.EventId"></select>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold text-dark">Họ và tên</label>
                                <input asp-for="FullName" class="form-control form-control-lg rounded-3" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-dark">Email</label>
                                <input asp-for="Email" class="form-control form-control-lg rounded-3" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="RoleTitle" class="form-label fw-bold text-dark">Vai trò / Chức danh</label>
                                <input asp-for="RoleTitle" class="form-control form-control-lg rounded-3" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InvitationCode" class="form-label fw-bold text-dark">Mã thư mời</label>
                                <input asp-for="InvitationCode" class="form-control form-control-lg bg-light fw-bold text-primary rounded-3" readonly />
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsCheckedIn" class="form-check-input" role="switch" />
                                <label asp-for="IsCheckedIn" class="form-check-label fw-semibold text-dark">
                                    Trạng thái đã check-in tại sự kiện
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-light border btn-lg rounded-pill px-4">Quay lại</a>
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill px-5 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i>Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>