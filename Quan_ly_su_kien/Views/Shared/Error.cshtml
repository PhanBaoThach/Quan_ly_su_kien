@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi Hệ Thống";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-start">
                <div class="text-center mb-4">
                    <div class="text-danger mb-2">
                        <i class="fas fa-exclamation-circle fa-4x opacity-75"></i>
                    </div>
                    <h2 class="fw-bold text-dark">Đã Xảy Ra Lỗi</h2>
                    <p class="text-muted">Hệ thống gặp sự cố khi xử lý yêu cầu của bạn.</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger rounded-3 p-3 mb-3 border-danger-subtle">
                        <div class="fw-bold text-danger mb-1">
                            <i class="fas fa-bug me-1"></i> Thông báo lỗi:
                        </div>
                        <div class="text-break font-monospace small">@ViewBag.ErrorMessage</div>
                        @if (ViewBag.ErrorPath != null)
                        {
                            <div class="mt-2 text-muted small">
                                <strong>Trang bị lỗi:</strong> <code>@ViewBag.ErrorPath</code>
                            </div>
                        }
                    </div>
                }

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-3">
                        <strong>Mã Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại trang trước
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-home me-1"></i> Về Trang Chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
