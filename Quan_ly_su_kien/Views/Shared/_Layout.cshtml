@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ApplicationUser? currentUser = null;
    IList<string>? userRoles = null;
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            userRoles = await UserManager.GetRolesAsync(currentUser);
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventMana</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Header Navigation -->
    <nav class="navbar navbar-expand-xl navbar-dark bg-dark sticky-top shadow-sm py-2">
        <div class="container-fluid px-3">
            <a class="navbar-brand fw-bold d-flex align-items-center text-nowrap me-2" asp-controller="Home" asp-action="Index">
                <span class="brand-icon me-2 text-primary bg-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                    <i class="fas fa-ticket-alt text-primary"></i>
                </span>
                <span class="fs-5 text-white">Event<span class="text-primary">Mana</span></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-xl-0 small">
                    <li class="nav-item">
                        <a class="nav-link text-white-50 px-2 fw-medium text-nowrap" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home me-1"></i> Trang Chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 px-2 fw-medium text-nowrap" asp-controller="Home" asp-action="Events">
                            <i class="fas fa-calendar-check me-1"></i> Khám Phá Sự Kiện
                        </a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-2 fw-medium text-nowrap" asp-controller="Registrations" asp-action="MyTickets">
                                <i class="fas fa-ticket-alt me-1 text-info"></i> Vé Của Tôi
                            </a>
                        </li>
                    }

                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Organizer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-2 fw-medium text-nowrap" asp-controller="Events" asp-action="MyEvents">
                                <i class="fas fa-calendar-alt me-1"></i> Quản Lý Sự Kiện
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-2 fw-medium text-nowrap" asp-controller="Reports" asp-action="Index">
                                <i class="fas fa-chart-bar me-1"></i> Báo Cáo
                            </a>
                        </li>
                    }

                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning fw-semibold px-2 text-nowrap" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-shield-alt me-1"></i> Quản Trị Hệ Thống
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow border-0">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-tachometer-alt me-2 text-info"></i> Bảng điều khiển (Dashboard)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users">
                                        <i class="fas fa-users-cog me-2 text-warning"></i> Quản lý Tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Categories">
                                        <i class="fas fa-tags me-2 text-success"></i> Quản lý Danh mục
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Configs">
                                        <i class="fas fa-sliders-h me-2 text-primary"></i> Quản lý Cấu hình
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="AuditLogs" asp-action="Index">
                                        <i class="fas fa-history me-2 text-warning"></i> Nhật ký hoạt động
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2 ms-auto">
                    @if (SignInManager.IsSignedIn(User) && currentUser != null)
                    {
                        var primaryRole = userRoles?.FirstOrDefault() ?? "Thành viên";
                        <div class="dropdown me-1">
                            <a class="btn btn-dark border-secondary rounded-circle position-relative d-flex align-items-center justify-content-center" href="#" role="button" id="notifBellDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="width: 38px; height: 38px;">
                                <i class="fas fa-bell text-warning"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notifBadge" style="font-size: 0.65rem;">
                                    0
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-0 mt-2" aria-labelledby="notifBellDropdown" style="width: 320px; max-width: 90vw;">
                                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark"><i class="fas fa-bell text-warning me-1"></i> Thông báo</span>
                                    <a asp-controller="Notifications" asp-action="Index" class="small text-primary text-decoration-none">Xem tất cả</a>
                                </div>
                                <div id="notifRecentList" class="overflow-auto" style="max-height: 280px;">
                                    <div class="p-3 text-center text-muted small">Đang tải thông báo...</div>
                                </div>
                                <div class="p-2 border-top text-center bg-light">
                                    <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-link text-decoration-none small text-primary p-0">Trung tâm thông báo &amp; nhắc lịch &rarr;</a>
                                </div>
                            </div>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-dark border-secondary rounded-pill d-flex align-items-center py-1 pe-2 ps-2 dropdown-toggle text-start text-nowrap" type="button" data-bs-toggle="dropdown">
                                <div class="avatar-circle me-2 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 30px; height: 30px;">
                                    @((currentUser.FullName ?? currentUser.UserName ?? "U").Substring(0, 1).ToUpper())
                                </div>
                                <div class="d-none d-md-block text-start me-2 text-truncate" style="max-width: 135px;">
                                    <div class="fw-semibold text-white small lh-1 text-truncate">@(currentUser.FullName ?? currentUser.UserName)</div>
                                    <div class="text-white-50" style="font-size: 0.7rem;">@primaryRole</div>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger rounded-pill px-2 py-1">Admin</span>
                                }
                                else if (User.IsInRole("Organizer"))
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1">BTC</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark rounded-pill px-2 py-1">Thành viên</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark">@(currentUser.FullName ?? currentUser.UserName)</div>
                                    <small class="text-muted text-break">@currentUser.Email</small>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user-circle me-2 text-primary"></i> Thông tin cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Registrations" asp-action="MyTickets">
                                        <i class="fas fa-ticket-alt me-2 text-info"></i> Vé của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Notifications" asp-action="Index">
                                        <i class="fas fa-bell me-2 text-warning"></i> Thông báo &amp; Nhắc lịch
                                    </a>
                                </li>
                                @if (User.IsInRole("Organizer"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Events" asp-action="MyEvents">
                                            <i class="fas fa-calendar-alt me-2 text-primary"></i> Sự kiện của tôi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Events" asp-action="Create">
                                            <i class="fas fa-plus-circle me-2 text-success"></i> Tạo sự kiện mới
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Reports" asp-action="Index">
                                            <i class="fas fa-chart-line me-2 text-info"></i> Báo cáo doanh thu
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                            <i class="fas fa-cog me-2 text-secondary"></i> Bảng quản trị
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users">
                                            <i class="fas fa-users me-2 text-secondary"></i> Quản lý tài khoản
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Categories">
                                            <i class="fas fa-tags me-2 text-secondary"></i> Quản lý danh mục
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Configs">
                                            <i class="fas fa-sliders-h me-2 text-secondary"></i> Quản lý cấu hình
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger rounded">
                                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-light rounded-pill px-3 text-nowrap" asp-controller="Account" asp-action="Login">
                            <i class="fas fa-sign-in-alt me-1"></i> Đăng Nhập
                        </a>
                        <a class="btn btn-primary rounded-pill px-3 fw-semibold shadow-sm text-nowrap" asp-controller="Account" asp-action="Register">
                            <i class="fas fa-user-plus me-1"></i> Đăng Ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Thông báo hệ thống Flash Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fas fa-check-circle fs-4 me-3 text-success"></i>
                <div class="flex-grow-1">
                    <strong>Thành công!</strong> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-triangle fs-4 me-3 text-danger"></i>
                <div class="flex-grow-1">
                    <strong>Thông báo:</strong> @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer Doanh Nghiệp / Sản Phẩm Chuyên Nghiệp -->
    <footer class="bg-dark text-white pt-5 pb-4 mt-5 border-top border-secondary">
        <div class="container">
            <div class="row g-4">
                <!-- Cột 1: Thông tin thương hiệu -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <span class="brand-icon me-2 text-primary bg-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="fas fa-ticket-alt text-primary"></i>
                        </span>
                        <h4 class="fw-bold mb-0 text-white">Event<span class="text-primary">Mana</span></h4>
                    </div>
                    <p class="text-white-50 small mb-3 lh-base">
                        Nền tảng quản lý sự kiện và phân phối vé trực tuyến hàng đầu. Giải pháp chuyển đổi số toàn diện cho hội thảo, âm nhạc, triển lãm và thể thao.
                    </p>
                    <div class="d-flex gap-3 text-white-50">
                        <a href="#" class="text-white-50 text-decoration-none fs-5"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="text-white-50 text-decoration-none fs-5"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="text-white-50 text-decoration-none fs-5"><i class="fab fa-linkedin"></i></a>
                        <a href="#" class="text-white-50 text-decoration-none fs-5"><i class="fab fa-github"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Liên kết nhanh -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="fw-bold text-white mb-3 text-uppercase">Khám Phá</h6>
                    <ul class="list-unstyled text-white-50 small mb-0">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Events" class="text-white-50 text-decoration-none">Tất cả sự kiện</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Events" asp-route-status="Open" class="text-white-50 text-decoration-none">Sự kiện đang mở</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register" class="text-white-50 text-decoration-none">Đăng ký tham gia</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Dành cho đối tác -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="fw-bold text-white mb-3 text-uppercase">Ban Tổ Chức</h6>
                    <ul class="list-unstyled text-white-50 small mb-0">
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register" class="text-white-50 text-decoration-none">Đăng ký tổ chức</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Giải pháp bán vé</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Quản lý check-in QR</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Bảng giá dịch vụ</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Hỗ trợ & Liên hệ -->
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold text-white mb-3 text-uppercase">Hỗ Trợ &amp; Liên Hệ</h6>
                    <ul class="list-unstyled text-white-50 small mb-3">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2 text-primary"></i>182 Lê Duẩn, TP. Vinh, Nghệ An</li>
                        <li class="mb-2"><i class="fas fa-phone-alt me-2 text-primary"></i>Hotline: 1900 6868 (8:00 - 21:00)</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2 text-primary"></i>Email: contact@eventmana.vn</li>
                    </ul>
                    <div class="input-group input-group-sm">
                        <input type="email" class="form-control" placeholder="Nhập email nhận bản tin sự kiện..." />
                        <button class="btn btn-primary" type="button">Đăng ký</button>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-white-50 small">
                <p class="mb-0">&copy; 2026 EventMana Platform. Bảo lưu mọi quyền.</p>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none">Chính sách bảo mật</a>
                    <span>•</span>
                    <a href="#" class="text-white-50 text-decoration-none">Điều khoản sử dụng</a>
                    <span>•</span>
                    <a href="#" class="text-white-50 text-decoration-none">Quy chế hoạt động</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                fetch('/Notifications/GetUnreadSummary')
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        var badge = document.getElementById('notifBadge');
                        if (badge && data.unreadCount > 0) {
                            badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                            badge.classList.remove('d-none');
                        }
                        var list = document.getElementById('notifRecentList');
                        if (list) {
                            if (!data.recent || data.recent.length === 0) {
                                list.innerHTML = '<div class="p-3 text-center text-muted small">Không có thông báo mới</div>';
                            } else {
                                var html = '';
                                data.recent.forEach(function (n) {
                                    var bg = !n.isRead ? 'bg-warning bg-opacity-10' : '';
                                    html += '<a href="/Notifications" class="d-block p-2 text-decoration-none border-bottom ' + bg + ' hover-light">' +
                                        '<div class="fw-bold text-dark small text-truncate">' + n.title + '</div>' +
                                        '<div class="text-secondary small text-truncate" style="font-size: 0.78rem;">' + n.message + '</div>' +
                                        '<div class="text-muted" style="font-size: 0.7rem;"><i class="fas fa-clock me-1"></i>' + n.createdAt + '</div>' +
                                        '</a>';
                                });
                                list.innerHTML = html;
                            }
                        }
                    })
                    .catch(function () {});
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>