@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg p-5">
                <div class="mb-4">
                    <span class="badge bg-danger-subtle text-danger rounded-circle p-4 d-inline-flex align-items-center justify-content-center shadow-sm">
                        <i class="fas fa-user-lock fa-4x"></i>
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-2">Truy Cập Bị Từ Chối (403)</h2>
                <p class="text-muted mb-4">
                    Rất tiếc! Tài khoản của bạn không có đủ thẩm quyền (Role) để truy cập vào phân hệ này. Phân hệ này yêu cầu đặc quyền Quản trị viên (Admin) hoặc Ban tổ chức (Organizer).
                </p>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-home me-2"></i>Về Trang Chủ
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Đổi Tài Khoản Khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

