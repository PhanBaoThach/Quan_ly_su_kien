@using Quan_ly_su_kien.Models
@model IEnumerable<Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục Sự Kiện";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/Admin">Quản trị</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Danh Mục</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-tags text-success me-2"></i>Quản Lý Danh Mục Sự Kiện
            </h2>
            <p class="text-muted small mb-0">Thêm mới, cập nhật thông tin, kích hoạt và quản lý phân loại sự kiện trên hệ thống</p>
        </div>
        <div class="mt-3 mt-md-0">
            <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                <i class="fas fa-plus me-2"></i>Thêm Danh Mục Mới
            </button>
        </div>
    </div>

    <!-- Bảng danh sách Danh mục -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Số sự kiện liên kết</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fas fa-folder-open fs-3 d-block mb-2"></i>
                                Chưa có danh mục sự kiện nào. Hãy thêm danh mục đầu tiên!
                            </td>
                        </tr>
                    }
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@cat.Id</td>
                            <td>
                                <span class="fw-bold text-dark fs-6">@cat.Name</span>
                            </td>
                            <td>
                                <span class="text-muted small">@(string.IsNullOrEmpty(cat.Description) ? "Không có mô tả" : cat.Description)</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary rounded-pill px-3 py-1">
                                    <i class="fas fa-calendar-alt me-1"></i>@(cat.Events?.Count ?? 0) sự kiện
                                </span>
                            </td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="fas fa-check-circle me-1"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                        <i class="fas fa-pause-circle me-1"></i>Tạm dừng
                                    </span>
                                }
                            </td>
                            <td>@cat.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <!-- Nút Sửa -->
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editCategoryModal-@cat.Id"
                                            title="Sửa danh mục">
                                        <i class="fas fa-edit"></i>
                                    </button>

                                    <!-- Nút Kích hoạt / Tạm dừng -->
                                    <form action="/Admin/ToggleCategoryStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-sm @(cat.IsActive ? "btn-outline-warning text-dark" : "btn-outline-success") rounded-circle"
                                                title="@(cat.IsActive ? "Tạm dừng hoạt động" : "Kích hoạt lại")">
                                            <i class="fas @(cat.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </button>
                                    </form>

                                    <!-- Nút Xóa -->
                                    <form action="/Admin/DeleteCategory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle"
                                                title="Xóa danh mục"
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục \'@cat.Name\'?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Modal Sửa Danh Mục -->
                                <div class="modal fade" id="editCategoryModal-@cat.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog text-start">
                                        <div class="modal-content border-0 shadow">
                                            <form action="/Admin/EditCategory" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@cat.Id" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Chỉnh Sửa Danh Mục: @cat.Name</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold small">Tên danh mục <span class="text-danger">*</span></label>
                                                        <input type="text" name="Name" value="@cat.Name" class="form-control" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold small">Mô tả danh mục</label>
                                                        <textarea name="Description" class="form-control" rows="3">@cat.Description</textarea>
                                                    </div>
                                                    <div class="form-check form-switch mb-2">
                                                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(cat.IsActive ? "checked" : "") id="catActive-@cat.Id">
                                                        <input type="hidden" name="IsActive" value="false" />
                                                        <label class="form-check-label fw-semibold small" for="catActive-@cat.Id">Trạng thái hoạt động</label>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="submit" class="btn btn-primary rounded-pill">Cập Nhật</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Danh Mục Mới -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form action="/Admin/CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-folder-plus text-success me-2"></i>Thêm Mới Danh Mục Sự Kiện
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Công nghệ thông tin" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mô tả danh mục</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Mô tả tóm tắt về loại hình sự kiện..."></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="newCatActive">
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label fw-semibold small" for="newCatActive">Kích hoạt ngay khi tạo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success rounded-pill">Thêm Danh Mục</button>
                </div>
            </form>
        </div>
    </div>
</div>
