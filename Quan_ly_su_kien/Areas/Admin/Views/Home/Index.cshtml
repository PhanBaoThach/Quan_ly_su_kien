@using Quan_ly_su_kien.ViewModels
@model IEnumerable<UserManagementViewModel>
@{
    ViewData["Title"] = "Bảng Quản Trị Hệ Thống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <!-- Header Dashboard -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-tachometer-alt text-primary me-2"></i>Bảng Điều Khiển Quản Trị
            </h2>
            <p class="text-muted small mb-0">Tổng quan chỉ số người dùng, hoạt động vận hành và phân loại sự kiện</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a href="/Admin/Users" class="btn btn-outline-primary rounded-pill px-3">
                <i class="fas fa-users-cog me-1"></i> Quản Lý Tài Khoản
            </a>
            <a href="/Admin/Categories" class="btn btn-primary rounded-pill px-3">
                <i class="fas fa-tags me-1"></i> Quản Lý Danh Mục
            </a>
        </div>
    </div>

    <!-- Hàng Thống kê (Statistics Cards) -->
    <div class="row g-3 mb-4">
        <!-- Tổng Người dùng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm p-3 h-100 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng Người Dùng</div>
                        <h2 class="fw-bold text-dark mb-0">@(ViewBag.TotalUsers ?? 0)</h2>
                        <small class="text-success"><i class="fas fa-user-check me-1"></i>@(ViewBag.ActiveUsers ?? 0) đang hoạt động</small>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="fas fa-users fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quản Trị Viên (Admin) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm p-3 h-100 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Quản Trị Viên</div>
                        <h2 class="fw-bold text-dark mb-0">@(ViewBag.AdminCount ?? 0)</h2>
                        <small class="text-muted">Đặc quyền hệ thống</small>
                    </div>
                    <div class="bg-danger-subtle text-danger rounded-circle p-3">
                        <i class="fas fa-shield-alt fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ban Tổ Chức (Organizer) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm p-3 h-100 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Ban Tổ Chức</div>
                        <h2 class="fw-bold text-dark mb-0">@(ViewBag.OrgCount ?? 0)</h2>
                        <small class="text-muted">Quản trị sự kiện & vé</small>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="fas fa-bullhorn fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Người Tham Gia (Attendee) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm p-3 h-100 border-start border-info border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Thành Viên Tham Gia</div>
                        <h2 class="fw-bold text-dark mb-0">@(ViewBag.AttCount ?? 0)</h2>
                        <small class="text-muted">Khán giả & khách mời</small>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3">
                        <i class="fas fa-user-friends fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách người dùng mới đăng ký -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fas fa-history text-secondary me-2"></i>Người Dùng Mới Nhất
            </h5>
            <a href="/Admin/Users" class="btn btn-sm btn-outline-secondary rounded-pill">
                Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Họ và tên / Username</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3 bg-light text-primary border rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                            @((!string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1) : (!string.IsNullOrEmpty(user.UserName) ? user.UserName.Substring(0, 1) : "U")).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@user.FullName</div>
                                            <small class="text-muted">@@@user.UserName</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-1"><i class="fas fa-shield-alt me-1"></i>Admin</span>
                                    }
                                    else if (user.Role == "Organizer")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="fas fa-bullhorn me-1"></i>Ban Tổ Chức</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-1"><i class="fas fa-user me-1"></i>Thành Viên</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1"><i class="fas fa-check-circle me-1"></i>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1"><i class="fas fa-lock me-1"></i>Đã khóa</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <!-- Nút Chi Tiết: Nhảy sang /Admin/Users và lọc luôn user này -->
                                    <a href="/Admin/Users?search=@user.UserName" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="fas fa-eye me-1"></i>Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-user-slash fs-3 d-block mb-2"></i>
                                Chưa có tài khoản người dùng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>